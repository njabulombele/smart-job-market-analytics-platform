# ── Backend ───────────────────────────────────────────────
JWT_SECRET=your-minimum-32-character-secret-key-replace-this
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000

# ── Database ───────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobmarket
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=1234

# ── Redis ─────────────────────────────────────────────────
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# ── Kafka ─────────────────────────────────────────────────
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── ML Service ────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=

# ── Job Collectors ────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_API_KEY=
RAPIDAPI_KEY=

# ── Azure (production) ────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
DUCKDB_PATH=/data/warehouse/jobmarket.duckdb
